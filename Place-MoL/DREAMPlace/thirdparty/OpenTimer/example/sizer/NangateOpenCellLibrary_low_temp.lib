  /******************************************************************************************
   Module          	: SDFFR_X1
   Cell Description	: Pos.edge D-Flip-Flop with active low reset, and active high scan, and drive strength X1
  *******************************************************************************************/

  cell (SDFFR_X1) {

	drive_strength     	: 1;

	ff ("IQ" , "IQN") {
		next_state         	: "((SE * SI) + (D * !SE))";
		clocked_on         	: "CK";
		clear              	: "!RN";
	}

	area               	: 6.650000;
	pg_pin(VDD) {
		voltage_name : VDD;
		pg_type      : primary_power;
	}
	pg_pin(VSS) {
		voltage_name : VSS;
		pg_type      : primary_ground;
	}


	cell_leakage_power 	: 260.523245;

	leakage_power () {
		when           : "!CK & !D & !RN & !SE & !SI & !Q & QN";
		value          : 202.520000;
	}
