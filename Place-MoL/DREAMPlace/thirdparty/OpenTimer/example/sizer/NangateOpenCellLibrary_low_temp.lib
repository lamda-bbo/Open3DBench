  /******************************************************************************************
   Module          	: SDFFR_X2
   Cell Description	: Pos.edge D-Flip-Flop with active low reset, and active high scan, and drive strength X2
  *******************************************************************************************/

  cell (SDFFR_X2) {

	drive_strength     	: 2;

	ff ("IQ" , "IQN") {
		next_state         	: "((SE * SI) + (D * !SE))";
		clocked_on         	: "CK";
		clear              	: "!RN";
	}

	area               	: 6.916000;
	pg_pin(VDD) {
