  /******************************************************************************************
   Module          	: SDFFS_X1
   Cell Description	: Pos.edge D-Flip-Flop with active high scan, and active low set, and drive strength X1
  *******************************************************************************************/

  cell (SDFFS_X1) {

	drive_strength     	: 1;

	ff ("IQ" , "IQN") {
		next_state         	: "((SE * SI) + (D * !SE))";
		clocked_on         	: "CK";
